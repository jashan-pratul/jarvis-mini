# ─────────────────────────────────────────────────────────────
#  Aadarsh's JARVIS — server configuration
#  Copy to `.env` and fill in. NEVER commit `.env`.
#  These values live ONLY on the server; nothing here is sent to the browser.
# ─────────────────────────────────────────────────────────────

# Required: Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model (default gemini-3-flash-preview or gemini-2.5-flash). Google Search grounding is enabled per request.
GEMINI_MODEL=gemini-3-flash-preview

# Thinking budget in tokens for chat replies (0 = fastest replies, higher = deeper reasoning).
GEMINI_THINKING_BUDGET=512

# Owner passcode protecting Aadarsh's memories, notes and secret-command editing.
# REQUIRED in production (min 6 characters). In development, if empty, owner routes are open.
OWNER_PASSCODE=

# Server port (most hosts inject PORT automatically)
PORT=8787

# development | production
NODE_ENV=development

# Comma-separated extra origins allowed by CORS (only needed if the frontend is hosted elsewhere).
CORS_ORIGINS=

# Set to 1 when running behind a reverse proxy / PaaS (Render, Railway, Fly, Nginx) so
# rate limiting sees the real client IP.
TRUST_PROXY=1

# SQLite database file location (directory is created automatically).
DATABASE_PATH=./database/jarvis.sqlite

# Rate limits
RATE_LIMIT_AI_PER_MINUTE=20
RATE_LIMIT_API_PER_15_MIN=300
